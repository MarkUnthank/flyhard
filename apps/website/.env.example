# Local development reads STRIPE_TEST_API_KEY from the repository root .env.
# For standalone local configuration, put these in ignored .dev.vars.
# Configure production secrets through the approved release process in AGENTS.md.
STRIPE_API_KEY=rk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Optional: sandbox email destination, configured as a staging secret.
# Requires the EMAIL binding and OUTBID_EMAIL_FROM; local dev sends no email.
# OUTBID_EMAIL_TEST_TO=operator@example.com

# Production social-image trigger: repository-scoped GitHub token, Actions read/write only.
# SOCIAL_IMAGES_GITHUB_TOKEN=replace_with_dedicated_token
