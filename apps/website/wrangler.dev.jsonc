{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "the-driving-fly",
  "main": "worker/api.ts",
  "compatibility_date": "2026-09-09",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "SITE_URL": "http://localhost:3000",
    "OUTBID_EMAIL_FROM": "mark@reallynice.company",
    "CUSTOM_WRAP_EMAIL_TEST_TO": "mark@reallynice.company",
  },
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_sender_addresses": ["mark@reallynice.company"],
    },
  ],
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/social/driving-fly-*"],
  },
  "durable_objects": {
    "bindings": [{ "name": "AUCTION", "class_name": "Auction" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Auction"] }],
  "r2_buckets": [
    { "binding": "ARTWORK", "bucket_name": "the-driving-fly-artwork" },
  ],
}
